# Inserir antes da location geral protegida por Basic Auth.
# A assinatura e a expiracao sao validadas pelo Spring antes de entregar o PDF.
location ~ ^/api/hub-crm/public/cotacoes/[0-9]+/pdf$ {
    auth_basic off;
    proxy_pass http://127.0.0.1:8788;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# O painel e as demais APIs continuam sujeitos a autenticacao do nginx.
location ^~ /hub-crm/ {
    proxy_pass http://127.0.0.1:8788;
}

location /api/hub-crm/ {
    proxy_pass http://127.0.0.1:8788;
}

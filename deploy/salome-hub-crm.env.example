# Hub CRM fica desligado ate banco, API e URL publica serem validados.
SALOME_HUB_CRM_ENABLED=true
SALOME_HUB_CRM_POLLING_ENABLED=false
SALOME_HUB_CRM_POLLING_DELAY_MS=30000
SALOME_HUB_CRM_CLIENT_CUTOFF=32001
SALOME_HUB_CRM_PILOT_SIZE=10

# Schema MariaDB proprio. O usuario deve ter acesso somente a salome_hub_crm.*
SALOME_HUB_CRM_DB_URL=jdbc:mysql://127.0.0.1:3306/salome_hub_crm?useSSL=false&serverTimezone=America/Sao_Paulo
SALOME_HUB_CRM_DB_USERNAME=salome_hub_crm
SALOME_HUB_CRM_DB_PASSWORD=SUBSTITUIR

SALOME_HUB_CRM_ARPA_URL=https://suite.arpacore.com.br
SALOME_HUB_CRM_ARPA_API_KEY=SUBSTITUIR_E_ROTACIONAR

# URL externa acessivel pelo WhatsApp. Chave HMAC com pelo menos 32 caracteres.
SALOME_HUB_CRM_PUBLIC_BASE_URL=https://SEU_DOMINIO
SALOME_HUB_CRM_MEDIA_SIGNING_KEY=GERAR_SEGREDO_FORTE
SALOME_HUB_CRM_MEDIA_TTL_MINUTES=60

# O mesmo datasource legado somente leitura ja usado pelo Financeiro.
SALOME_LEGACY_DB_ENABLED=true
SALOME_LEGACY_DB_URL=jdbc:mysql://HOST:3306/salome_rp?useSSL=true&serverTimezone=America/Sao_Paulo
SALOME_LEGACY_DB_USERNAME=USUARIO_SOMENTE_LEITURA
SALOME_LEGACY_DB_PASSWORD=SUBSTITUIR
